{
  "$schema": "https://schemas.wp.org/wp/6.5/theme.json",
  "version": 2,
  "title": "Boodoo",
  "settings": {
    "appearanceTools": true,
    "color": {
      "custom": true,
      "customGradient": true,
      "defaultGradients": false,
      "defaultPalette": false,
      "duotone": [],
      "palette": [
        { "name": "Primary", "slug": "primary", "color": "#7c3aed" },
        { "name": "Primary Hover", "slug": "primary-hover", "color": "#6d28d9" },
        { "name": "Secondary", "slug": "secondary", "color": "#4b5563" },
        { "name": "Success", "slug": "success", "color": "#10b981" },
        { "name": "Warning", "slug": "warning", "color": "#f59e0b" },
        { "name": "Danger", "slug": "danger", "color": "#ef4444" },
        { "name": "Info", "slug": "info", "color": "#3b82f6" },
        { "name": "Dark", "slug": "dark", "color": "#0f172a" },
        { "name": "Light", "slug": "light", "color": "#f8fafc" },
        { "name": "White", "slug": "white", "color": "#ffffff" },
        { "name": "Background", "slug": "background", "color": "#ffffff" },
        { "name": "Surface Muted", "slug": "surface-muted", "color": "#f1f5f9" }
      ],
      "gradients": [
        {
          "name": "Boodoo Gradient",
          "slug": "boodoo-gradient",
          "gradient": "linear-gradient(135deg, #7c3aed 0%, #3b82f6 100%)"
        },
        {
          "name": "Sunset Purple",
          "slug": "sunset-purple",
          "gradient": "linear-gradient(135deg, #a855f7 0%, #ec4899 100%)"
        },
        {
          "name": "Dark Surface",
          "slug": "dark-surface",
          "gradient": "linear-gradient(135deg, #0f172a 0%, #1e293b 100%)"
        }
      ]
    },
    "typography": {
      "customFontSize": true,
      "fontStyle": true,
      "fontWeight": true,
      "letterSpacing": true,
      "lineHeight": true,
      "textDecoration": true,
      "textTransform": true,
      "fontFamilies": [
        {
          "fontFamily": "'Inter', system-ui, -apple-system, sans-serif",
          "name": "Inter",
          "slug": "inter"
        },
        {
          "fontFamily": "'JetBrains Mono', monospace",
          "name": "JetBrains Mono",
          "slug": "monospace"
        }
      ],
      "fontSizes": [
        { "name": "Small", "slug": "small", "size": "0.875rem" },
        { "name": "Normal", "slug": "normal", "size": "1rem" },
        { "name": "Medium", "slug": "medium", "size": "1.25rem" },
        { "name": "Large", "slug": "large", "size": "1.5rem" },
        { "name": "Extra Large", "slug": "x-large", "size": "2rem" },
        { "name": "Display Large", "slug": "display-large", "size": "3rem" }
      ]
    },
    "layout": {
      "contentSize": "800px",
      "wideSize": "1200px"
    },
    "spacing": {
      "customMargin": true,
      "customPadding": true,
      "spacingScale": {
        "operator": "*",
        "increment": 1.5,
        "steps": 7,
        "mediumStep": 1.5,
        "unit": "rem"
      }
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--background)",
      "text": "var(--wp--preset--color--dark)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--inter)",
      "lineHeight": "1.6"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--primary)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--primary-hover)"
          }
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "var(--wp--preset--color--white)"
        },
        "border": {
          "radius": "9999px"
        },
        "spacing": {
          "padding": {
            "top": "0.625rem",
            "bottom": "0.625rem",
            "left": "1.5rem",
            "right": "1.5rem"
          }
        }
      }
    }
  }
}
