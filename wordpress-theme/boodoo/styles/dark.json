{
  "$schema": "https://schemas.wp.org/wp/6.5/theme.json",
  "version": 2,
  "title": "Dark Mode",
  "settings": {
    "color": {
      "palette": [
        { "name": "Primary", "slug": "primary", "color": "#a855f7" },
        { "name": "Background", "slug": "background", "color": "#0f172a" },
        { "name": "Surface Muted", "slug": "surface-muted", "color": "#1e293b" },
        { "name": "Text", "slug": "dark", "color": "#f8fafc" },
        { "name": "White", "slug": "white", "color": "#1e293b" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--background)",
      "text": "var(--wp--preset--color--dark)"
    }
  }
}
