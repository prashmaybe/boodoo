{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": "2",
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "800px",
      "wideSize": "1200px"
    },
    "color": {
      "palette": [
        { "slug": "primary", "color": "#7c3aed", "name": "Budu Purple" },
        { "slug": "secondary", "color": "#4f46e5", "name": "Indigo" },
        { "slug": "dark", "color": "#0f172a", "name": "Dark Slate" },
        { "slug": "light", "color": "#f8fafc", "name": "Light Slate" },
        { "slug": "white", "color": "#ffffff", "name": "White" }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
          "slug": "sans-serif",
          "name": "Inter / System Sans"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--budu-bg-body, #ffffff)",
      "text": "var(--budu-text-main, #0f172a)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--sans-serif)",
      "lineHeight": "1.6"
    }
  }
}
